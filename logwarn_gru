#!/bin/bash

journalctl --cursor-file=/var/lib/logwarn/openqa-gru -u openqa-gru \
    | rg -e 'ERROR:' -e 'WARNING:' \
    | rg --engine pcre2 --invert-match \
    `# The following lines contain grep calls to ignore known issues` \
    `# https://progress.opensuse.org/issues/207957` \
    -e 'LLM API' -e 'openqa-llm-investigate failed' \
    || true
