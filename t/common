set -e -o pipefail

declare -i testnum=0
declare -i rc=0
pass() {
    testnum+=1
    echo "ok $testnum - $1"
}
fail() {
    testnum+=1
    echo "not ok $testnum - $1"
    rc=1
}
done-testing() {
    echo "1..$testnum"
    # explicitly exit with $rc unless we are run by prove
    [[ -n $HARNESS_ACTIVE ]] || exit $rc
}
is-ignored() {
    local string=$1 label=$2
    if ! echo "$in_log" | grep -q "$string"; then
        fail "[reverse-check] >>$string<< - make sure the string you want to ignore is in test log"
        echo "# ====================================================================="
        echo "# Explanation: is-ignored() is ensuring that logwarn will filter the"
        echo "# given string."
        echo "# For that it first runs a test to check if a matching line is actually"
        echo "# contained in test log"
        echo "# ====================================================================="
        return
    fi
    label=${label:-"String >>$string<< is ignored"}
    if echo "$out" | grep -q "$string"; then
        fail "$label"
    else
        pass "$label"
    fi
}
is-included() {
    local string=$1 label=$2
    label=${label:-"String >>$string<< is included"}
    if echo "$out" | grep -q "$string"; then
        pass "$label"
    else
        fail "$label"
    fi
}
